# ==============================================================================
# Veyra AI Security Engine - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model Inference Configuration (Open-Weight Model via Ollama)
# ------------------------------------------------------------------------------
# Base URL for the Ollama inference server (e.g., local server or DigitalOcean Droplet)
OLLAMA_BASE_URL=http://localhost:11434

# Open-weight model identifier (e.g., gemma2:9b, gemma2:27b, mistral:7b)
OLLAMA_MODEL=gemma2:9b

# Bearer API Key (leave empty for unauthenticated local Ollama instances)
OLLAMA_API_KEY=

# HTTP timeout in seconds for inference calls
OLLAMA_TIMEOUT_SECONDS=15.0

# Explicit Offline Demo Mode (set to "true" to test/demo without a live Ollama host)
VEYRA_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. Security Policy Engine Thresholds
# ------------------------------------------------------------------------------
# Conservative fail-closed posture: route unverified/errored requests to QUARANTINE
FAIL_CLOSED_ON_ERROR=true

# Composite risk score threshold (0.0 to 1.0) for BLOCK verdicts
RISK_THRESHOLD_BLOCK=0.70

# Composite risk score threshold (0.0 to 1.0) for QUARANTINE verdicts
RISK_THRESHOLD_QUARANTINE=0.35

# ------------------------------------------------------------------------------
# 3. Persistence & Privacy Configuration
# ------------------------------------------------------------------------------
# SQLite file storage path (mount persistent volume to /app/data on DigitalOcean)
DATABASE_PATH=./data/veyra.db

# PRIVACY CONTROLS:
# By default (false), raw prompt text is NOT stored in the database.
# Set to "true" ONLY if explicit prompt retention is required for compliance/audit.
STORE_RAW_PROMPTS=false

# ------------------------------------------------------------------------------
# 4. Web Server & Network Security
# ------------------------------------------------------------------------------
# Host bind address (0.0.0.0 required for container deployments)
HOST=0.0.0.0

# HTTP Port (DigitalOcean App Platform dynamically injects $PORT)
PORT=8000

# Permitted CORS Origins (comma-separated, e.g., https://your-domain.ondigitalocean.app)
ALLOWED_ORIGINS=*

# Rate limiting: maximum requests allowed per minute per client IP
RATE_LIMIT_PER_MINUTE=60

# Maximum permitted prompt length in characters (default 32,000)
MAX_PROMPT_LENGTH=32000
